generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum WafSecurityAction {
  ALLOW
  BLOCK
  CAPTCHA
  CHALLENGE
  COUNT
}

enum WafChallengeType {
  CAPTCHA
  JS_CHALLENGE
}

enum WafChallengeStatus {
  NOT_APPLICABLE
  PENDING
  PASSED
  FAILED
  EXPIRED
}

enum NginxLimitStatus {
  ALLOWED
  RATE_LIMITED
  CONNECTION_LIMITED
  REJECTED
}

enum GatewayDecisionStatus {
  ALLOWED
  RATE_LIMITED
  REJECTED
}

enum GatewayPolicyStatus {
  ALLOWED
  DENIED
  ERROR
}

enum UserRole {
  RIDER
  VENDOR
  ADMIN
  SUPPORT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum AuthFlowIntent {
  CREDENTIALS_SIGNUP
  CREDENTIALS_SIGNIN

  GOOGLE_OAUTH_SIGNUP
  GOOGLE_OAUTH_SIGNIN

  PASSWORD_RECOVERY
  PASSWORD_CHANGE

  ACCOUNT_ACTIVATION
  ACCOUNT_RECOVERY
  ACCOUNT_DELETION

  OTP_VERIFICATION
  OTP_RESEND

  TOKEN_REFRESH

  SESSION_LOGOUT
  SESSION_LOGOUT_ALL
  SESSION_REVOKE
}

enum RiskDecision {
  ALLOW
  CHALLENGE_OTP
  REJECT
}

enum OtpPurpose {
  EMAIL_VERIF
  RISK_CHALLENGE
  STEP_UP_MFA
  PASSWORD_RECOVERY
  ACCOUNT_RECOVERY
  ACCOUNT_DELETION
}

enum OtpOriginatingFlow {
  NEW_SIGNUP
  EXISTING_SIGNIN
  ACCOUNT_ACTIVATION
  ACCOUNT_RECOVERY
  PASSWORD_RECOVERY
  ACCOUNT_DELETION
}

enum OAuthProvider {
  GOOGLE
}

enum OAuthLinkMethod {
  INITIAL_SIGNUP
  AUTO_VERIFIED_LINK
  OTP_VERIFIED_LINK
}

enum SessionRevokeReason {
  CONCURRENCY_LIMIT_EXCEEDED
  USER_LOGOUT
  TOKEN_ROTATION
  REUSE_DETECTED
  ADMIN_OR_SECURITY_LOCK
}

enum SecurityEventType {
  SIGNUP_RISK_REJECTED
  SIGNUP_RISK_OTP_FAILED

  RESTRICTED_ACCOUNT_ACCESS_ATTEMPT
  CREDENTIALS_INVALID_PASSWORD

  OTP_MAX_ATTEMPTS_LOCKOUT

  OAUTH_STATE_MISMATCH_OR_REPLAY
  OAUTH_TOKEN_EXCHANGE_FAILED
  OAUTH_ID_TOKEN_VALIDATION_FAILED
  OAUTH_UNVERIFIED_EMAIL_REJECTED

  STEP_UP_MFA_LOCKOUT
  NEW_DEVICE_SIGNIN_DETECTED

  SESSION_REVOKED_CONCURRENCY
  REFRESH_TOKEN_REUSE_DETECTED
}

//
// USERS
//

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String         @db.VarChar(120)
  email             String         @unique(map: "idx_users_email_unique") @db.VarChar(255)

  role              UserRole       @default(RIDER)

  passwordHash      String?        @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?      @map("password_changed_at") @db.Timestamptz(6)

  isVerified        Boolean        @default(false) @map("is_verified")
  emailVerifiedAt   DateTime?      @map("email_verified_at") @db.Timestamptz(6)

  phoneNumber       String?        @map("phone_number") @db.VarChar(32)
  phoneVerifiedAt   DateTime?      @map("phone_verified_at") @db.Timestamptz(6)

  accountStatus     AccountStatus  @default(PENDING) @map("account_status")

  suspendedAt       DateTime?      @map("suspended_at") @db.Timestamptz(6)
  suspensionReason  String?        @map("suspension_reason")

  blockedAt         DateTime?      @map("blocked_at") @db.Timestamptz(6)
  blockedReason     String?        @map("blocked_reason")

  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)

  mfaFailedAttempts Int            @default(0) @map("mfa_failed_attempts")
  mfaLastFailedAt   DateTime?      @map("mfa_last_failed_at") @db.Timestamptz(6)
  mfaLockedUntil    DateTime?      @map("mfa_locked_until") @db.Timestamptz(6)

  lastLoginAt       DateTime?      @map("last_login_at") @db.Timestamptz(6)

  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  signupRiskEvaluations SignupRiskEvaluation[]
  otpChallenges     OtpChallenge[]
  trustedDevices    TrustedDevice[]
  sessions          UserSession[]
  refreshTokens     RefreshToken[]
  oauthIdentities   OAuthIdentity[]
  auditLogs         AuthAuditLog[]

  @@index([accountStatus, isVerified], map: "idx_users_status_verified")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@index([accountStatus, mfaLockedUntil], map: "idx_users_mfa_lockout")
  @@map("users")
}


model SignupRiskEvaluation {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId                  String?                @map("user_id") @db.Uuid
  user                    User?                  @relation(fields: [userId], references: [id])
  riskOtpChallenge         OtpChallenge?           @relation("RiskOtpChallenge", fields: [riskOtpChallengeId], references: [id], onDelete: SetNull)
  oauthPkceStates          OAuthPkceState[]

  emailNormalized         String?                @map("email_normalized") @db.VarChar(255)

  flowIntent              AuthFlowIntent         @map("flow_intent")

  edgeRequestId           String                 @map("edge_request_id") @db.VarChar(128)
  wafBotScore             Int?                   @map("waf_bot_score")
  wafBotSignals           String[]               @default([]) @map("waf_bot_signals")
  wafIpReputation         String?                @map("waf_ip_reputation")

  wafSecurityAction       WafSecurityAction      @map("waf_security_action")
  wafChallengeType        WafChallengeType?      @map("waf_challenge_type")
  wafChallengeStatus      WafChallengeStatus     @default(NOT_APPLICABLE) @map("waf_challenge_status")

  wafRateLimitTriggered   Boolean                @default(false) @map("waf_rate_limit_triggered")

  nginxRequestId          String                 @map("nginx_request_id")

  clientIp                String                 @map("client_ip") @db.Inet
  peerIp                  String                 @map("peer_ip") @db.Inet

  requestMethod           String                 @map("request_method") @db.VarChar(10)
  requestUri              String                 @map("request_uri") @db.VarChar(512)

  connectionConcurrency   Int?                   @map("connection_concurrency")

  connectionLimitStatus   NginxLimitStatus       @map("connection_limit_status")
  localRateLimitOutcome   NginxLimitStatus       @map("local_rate_limit_outcome")

  gatewayRequestId        String                 @map("gateway_request_id") @db.VarChar(128)
  gatewayRateLimitStatus  GatewayDecisionStatus  @map("gateway_rate_limit_status")
  gatewayPolicyStatus     GatewayPolicyStatus    @map("gateway_policy_status")

  upstreamService         String                 @default("AUTH_SERVICE") @map("upstream_service") @db.VarChar(100)

  deviceFingerprintHash   String                 @map("device_fingerprint_hash") @db.Char(64)

  userAgent               String                 @map("user_agent")
  coarseLocation          String?                @map("coarse_location")

  isDisposableEmail       Boolean                @default(false) @map("is_disposable_email")
  isRateOrSubnetSurge     Boolean                @default(false) @map("is_rate_or_subnet_surge")

  totalRiskScore          Int                    @map("total_risk_score")
  decision                RiskDecision

  riskOtpChallengeId      String?                @map("risk_otp_challenge_id") @db.Uuid
  riskOtpPassed           Boolean?               @map("risk_otp_passed")

  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)



  @@index([emailNormalized], map: "idx_risk_eval_email")
  @@index([clientIp], map: "idx_risk_eval_ip")
  @@index([deviceFingerprintHash], map: "idx_risk_eval_device_fp")
  @@index([createdAt], map: "idx_risk_eval_created_at")
  @@index([edgeRequestId], map: "idx_risk_eval_edge_request")
  @@index([nginxRequestId], map: "idx_risk_eval_nginx_request")
  @@index([gatewayRequestId], map: "idx_risk_eval_gateway_request")
  @@index([flowIntent], map: "idx_risk_eval_flow_intent")
  @@index([decision], map: "idx_risk_eval_decision")

  @@map("signup_risk_evaluations")
}

//
// OTP CHALLENGES
//

model OtpChallenge {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId                    String?             @db.Uuid
  user                      User?               @relation(fields: [userId], references: [id])
  riskEvaluations           SignupRiskEvaluation[] @relation("RiskOtpChallenge")

  emailNormalized           String              @map("email_normalized") @db.VarChar(255)

  purpose                   OtpPurpose
  originatingFlow           OtpOriginatingFlow  @map("originating_flow")
  originatingFlowIntent     AuthFlowIntent      @map("originating_flow_intent")

  otpHash                   String              @map("otp_hash") @db.Char(64)

  attempts                  Int                 @default(0)
  maxAttempts               Int                 @default(5)

  isLocked                  Boolean             @default(false)

  pendingOauthProvider      OAuthProvider?      @map("pending_oauth_provider")
  pendingOauthSub           String?             @map("pending_oauth_sub")
  pendingOauthName          String?             @map("pending_oauth_name")

  requestIp                 String              @map("request_ip") @db.Inet
  deviceFingerprintHash     String              @map("device_fingerprint_hash") @db.Char(64)

  expiresAt                 DateTime            @map("expires_at") @db.Timestamptz(6)
  usedAt                    DateTime?           @map("used_at") @db.Timestamptz(6)
  revokedAt                 DateTime?           @map("revoked_at") @db.Timestamptz(6)

  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose, usedAt], map: "idx_otp_user_purpose_used")
  @@index([emailNormalized, purpose, expiresAt], map: "idx_otp_email_purpose_expiry")
  @@index([expiresAt], map: "idx_otp_expiry")
  @@index([deviceFingerprintHash, createdAt], map: "idx_otp_device_created")
  @@map("otp_challenges")
}

//
// TRUSTED DEVICES
//

model TrustedDevice {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId                 String          @db.Uuid
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceFingerprintHash  String          @map("device_fingerprint_hash") @db.Char(64)

  browser                String?         @db.VarChar(80)
  os                     String?         @db.VarChar(80)

  userAgent              String          @map("user_agent")

  lastIp                 String          @map("last_ip") @db.Inet
  coarseLocation         String?         @map("coarse_location")

  isInitialSignupDevice  Boolean         @default(false) @map("is_initial_signup_device")

  isRevoked              Boolean         @default(false)

  lastSeenAt             DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  trustedUntil           DateTime        @map("trusted_until") @db.Timestamptz(6)

  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions               UserSession[]

  @@unique([userId, deviceFingerprintHash], map: "idx_trusted_devices_user_fp_unique")
  @@index([userId, isRevoked, trustedUntil], map: "idx_trusted_devices_active_lookup")
  @@map("trusted_devices")
}

//
// USER SESSIONS
//

model UserSession {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId                String               @db.Uuid
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  trustedDeviceId       String?              @db.Uuid
  trustedDevice         TrustedDevice?       @relation(fields: [trustedDeviceId], references: [id])

  familyId              String               @unique(map: "idx_sessions_family_id") @map("family_id") @db.Uuid

  clientIp              String               @map("client_ip") @db.Inet
  deviceFingerprintHash String               @map("device_fingerprint_hash") @db.Char(64)

  isActive              Boolean              @default(true) @map("is_active")

  revokedAt             DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason          SessionRevokeReason? @map("revoke_reason")

  lastActiveAt          DateTime             @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt             DateTime             @map("expires_at") @db.Timestamptz(6)

  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  refreshTokens         RefreshToken[]

  @@index([userId, isActive, createdAt], map: "idx_sessions_user_active_fifo")
  @@map("user_sessions")
}

//
// REFRESH TOKENS
//

model RefreshToken {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sessionId       String          @db.Uuid
  session         UserSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId        String          @db.Uuid @map("family_id")

  tokenHash       String          @unique(map: "idx_refresh_tokens_hash") @map("token_hash") @db.Char(64)

  parentTokenId   String?         @map("parent_token_id") @db.Uuid
  parentToken     RefreshToken?   @relation("TokenChain", fields: [parentTokenId], references: [id])
  childTokens     RefreshToken[]  @relation("TokenChain")

  isRevoked       Boolean         @default(false)

  usedAt          DateTime?       @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(6)

  expiresAt       DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([sessionId, isRevoked], map: "idx_refresh_tokens_session_active")
  @@map("refresh_tokens")
}

//
// OAUTH IDENTITIES
//

model OAuthIdentity {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId                String            @db.Uuid
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider              OAuthProvider     @default(GOOGLE)

  providerUserId        String            @map("provider_user_id") @db.VarChar(255)
  providerEmail         String            @map("provider_email") @db.VarChar(255)

  providerEmailVerified Boolean           @default(true) @map("provider_email_verified")

  providerName          String?           @map("provider_name")

  linkedVia             OAuthLinkMethod   @map("linked_via")

  lastUsedAt            DateTime          @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerUserId], map: "idx_oauth_provider_sub_unique")
  @@unique([userId, provider], map: "idx_oauth_user_provider_unique")
  @@index([providerEmail], map: "idx_oauth_provider_email")
  @@map("oauth_identities")
}

//
// AUTH AUDIT LOGS
//

model AuthAuditLog {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId                String?           @db.Uuid
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  emailAttempted        String?           @map("email_attempted") @db.VarChar(255)

  eventType             SecurityEventType @map("event_type")

  flowIntent            AuthFlowIntent?   @map("flow_intent")

  nginxRequestId        String?           @map("nginx_request_id")
  clientIp              String            @map("client_ip") @db.Inet

  deviceFingerprintHash String?           @map("device_fingerprint_hash")
  userAgent             String?           @map("user_agent")

  metadata              Json?

  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt], map: "idx_audit_user_time")
  @@index([eventType, createdAt], map: "idx_audit_event_time")
  @@index([clientIp], map: "idx_audit_client_ip")
  @@map("auth_audit_logs")
}


model OAuthPkceState {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  stateHash             String           @unique(map: "idx_oauth_pkce_state_hash") @map("state_hash") @db.Char(64)

  codeVerifierEncrypted String           @map("code_verifier_encrypted")
  codeChallenge         String           @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod   String           @default("S256") @map("code_challenge_method") @db.VarChar(10)

  flowIntent            AuthFlowIntent   @map("flow_intent")

  wasRiskChecked        Boolean          @default(false) @map("was_risk_checked")

  riskEvaluationId      String?          @map("risk_evaluation_id") @db.Uuid
  riskEvaluation        SignupRiskEvaluation? @relation(fields: [riskEvaluationId], references: [id], onDelete: SetNull)

  redirectUri           String           @map("redirect_uri")

  clientIp              String           @map("client_ip") @db.Inet
  deviceFingerprintHash String           @map("device_fingerprint_hash") @db.Char(64)

  userAgent             String           @map("user_agent")

  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt            DateTime?        @map("consumed_at") @db.Timestamptz(6)

  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_oauth_pkce_expires_at")
  @@map("oauth_pkce_states")
}
